NODE_ENV=development
POSTGRES_PASSWORD=qagent_local_password
DATABASE_URL=postgresql://qagent:qagent_local_password@localhost:5432/qagent?schema=public
API_PORT=3101
WEB_ORIGIN=http://localhost:3110
QAGENT_STORAGE_DIR=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Chave do OpenRouter. Mantenha este valor somente no backend e nunca o versione.
OPENAI_API_KEY=
# Base compatível com a API OpenAI do OpenRouter.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ID exato de um modelo disponível no catálogo do OpenRouter.
OPENAI_MODEL=
# Lista opcional (IDs separados por vírgulas) de modelos disponíveis para seleção.
OPENAI_MODELS=
NEXT_PUBLIC_API_URL=http://localhost:3101
PLAYWRIGHT_BASE_URL=http://localhost:3110
