generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Environment {
  WORK
  LEARN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum WritingStyle {
  NATURAL
  BALANCED
  STRUCTURED
  OBJECTIVE
}

enum ResponseDetail {
  SHORT
  MEDIUM
  COMPLETE
}

enum QaToolType {
  REQUIREMENT_ANALYSIS
  RISK_ANALYSIS
  TEST_CASES
  BDD
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectKnowledgeKind {
  DOCUMENT
  DECISION
  REQUIREMENT
  FILE_LINK
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  email          String          @unique @db.VarChar(254)
  phone          String?         @db.VarChar(16)
  passwordHash   String
  status         UserStatus      @default(ACTIVE)
  writingStyle   WritingStyle    @default(BALANCED)
  responseDetail ResponseDetail  @default(MEDIUM)
  aiModel        String?         @db.VarChar(120)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile?
  conversations  Conversation[]
  projects       Project[]
  toolExecutions ToolExecution[]
  learnProgress  LearnProgress[]
  fileFolders    FileFolder[]
  workspaceFiles WorkspaceFile[]
}

model Profile {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @unique @db.Uuid
  type      Environment
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  projectId   String?     @db.Uuid
  title       String      @db.VarChar(200)
  environment Environment
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([userId, environment, updatedAt])
  @@index([userId, environment, projectId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Project {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  name          String             @db.VarChar(160)
  description   String?            @db.VarChar(2000)
  category      String?            @db.VarChar(100)
  status        ProjectStatus      @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  knowledge     ProjectKnowledge[]
  tasks         ProjectTask[]
  diagrams      ProjectDiagram[]
  fileFolders   FileFolder[]
  files         WorkspaceFile[]

  @@unique([userId, name])
  @@index([userId, status, updatedAt])
}

model ProjectKnowledge {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @db.Uuid
  kind        ProjectKnowledgeKind
  title       String               @db.VarChar(200)
  content     String               @db.Text
  externalUrl String?              @db.VarChar(2048)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, updatedAt])
}

model ProjectTask {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  title       String              @db.VarChar(200)
  description String?             @db.VarChar(2000)
  status      ProjectTaskStatus   @default(TODO)
  priority    ProjectTaskPriority @default(MEDIUM)
  dueAt       DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, updatedAt])
}

model ProjectDiagram {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  name       String   @db.VarChar(200)
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
}

model ToolExecution {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  environment  Environment @default(WORK)
  tool         QaToolType
  input        String      @db.Text
  result       String      @db.Text
  model        String      @db.VarChar(120)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, environment, createdAt])
}

model LearnProgress {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  lessonId        String             @db.VarChar(120)
  attempts        Int                @default(0)
  bestScore       Int?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningAttempts LearningAttempt[]

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

model LearningAttempt {
  id           String       @id @default(uuid()) @db.Uuid
  progressId   String       @db.Uuid
  answer       String       @db.Text
  score        Int
  passed       Boolean
  feedback     String       @db.Text
  strengths    Json
  improvements Json
  model        String       @db.VarChar(120)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime     @default(now())
  progress     LearnProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId, createdAt])
}

model FileFolder {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  environment Environment
  projectId  String?      @db.Uuid
  parentId   String?      @db.Uuid
  name       String       @db.VarChar(180)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent     FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   FileFolder[] @relation("FolderTree")
  files      WorkspaceFile[]

  @@index([userId, environment, projectId, parentId, name])
}

model WorkspaceFile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  environment Environment
  projectId   String?     @db.Uuid
  folderId    String?     @db.Uuid
  name        String      @db.VarChar(255)
  storageKey  String      @unique @db.VarChar(36)
  mimeType    String      @db.VarChar(255)
  size        Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder      FileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, environment, projectId, folderId, name])
}
